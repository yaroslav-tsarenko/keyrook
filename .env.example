# ============================================================
# Keyrook — environment template
# Copy to .env (or set these in your host, e.g. Vercel) and fill in real values.
# Never commit real secrets — .env and .env*.local are gitignored.
# ============================================================

# ============================================================
# Database — PostgreSQL (Neon in production, Prisma Postgres locally)
# ============================================================
# App runtime + Prisma CLI connection (pooled).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) connection — used by migrations and seed.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ============================================================
# Auth
# ============================================================
# Random 32+ byte secret. Generate: openssl rand -base64 32
JWT_SECRET="change-this-to-a-random-secret-in-production"
# Optional: npx prisma db seed creates this admin when both are set (password 12+ characters).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ============================================================
# App Config
# ============================================================
# Public base URL, no trailing slash. Used in emails, SEO, sitemap.
NEXT_PUBLIC_SITE_URL="https://keyrook.com"
# Absolute base URL used for payment return and webhook URLs. Defaults to NEXT_PUBLIC_SITE_URL.
# Must be the main domain, never a *.vercel.app preview URL.
APP_URL="https://keyrook.com"

# ============================================================
# Cloudflare R2 — storage for images uploaded in the admin (banners, pages).
# Product cover art is served from our own domain through /media/<id>.
# ============================================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# ============================================================
# Social Media
# ============================================================
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""

# ============================================================
# SMTP — transactional emails (welcome, order confirmation,
# invoice, keys-ready and refund updates, password reset, contact form)
# Provider: Spacemail. Host mail.spacemail.com, port 587 (STARTTLS)
# or 465 (implicit TLS). Username/password are the mailbox credentials.
# ============================================================
SMTP_HOST="mail.spacemail.com"
SMTP_PORT="587"
# "true" only for port 465 (implicit TLS); leave "false" for 587 (STARTTLS).
SMTP_SECURE="false"
SMTP_USER="youremail@example.com"
SMTP_PASSWORD="your-mailbox-password"
# From address must belong to the authenticated mailbox's domain.
SMTP_FROM="Keyrook <youremail@example.com>"
# Where contact-form submissions land and where customers reply.
SMTP_REPLY_TO="youremail@example.com"

# ============================================================
# Payments — see "Payments" in README.md
# PAYMENT_PROVIDER picks the provider registered in src/lib/payments/provider.ts.
#   none  no card provider connected: checkout answers 503 PAYMENTS_NOT_CONNECTED and creates no order.
#   mock  local testing only: a test payment page at /checkout/mock-pay with Pay / Fail buttons.
#         Refused unless NODE_ENV is not "production" AND PAYMENT_MOCK_ENABLED=true.
# Provider webhooks arrive at https://<your-domain>/api/webhooks/payment/<provider>
# ============================================================
PAYMENT_PROVIDER="none"
PAYMENT_MOCK_ENABLED="false"

# ============================================================
# Key distribution partner — ESA Integration API (catalogue sync and key orders)
# Never shown to customers. Validated in src/lib/env.ts.
# ============================================================
# API key of the ESA store (dashboard → Integrations). Sent as X-Api-Key.
KINGUIN_API_KEY=""
# Base URL without the version suffix (/v1 or /v2 is added per call). The www host is Cloudflare-gated; use the gateway.
KINGUIN_API_BASE="https://gateway.kinguin.net/esa/api"
# Optional OAuth2 client-credentials fallback, used only when KINGUIN_API_KEY is empty.
KINGUIN_CLIENT_ID=""
KINGUIN_CLIENT_SECRET=""
KINGUIN_OAUTH_TOKEN_URL=""
# "true" places real, paid orders against your supplier balance. Leave "false" until the balance is funded and you have tested end to end.
# With "false", key orders go to KINGUIN_SANDBOX_API_BASE instead (the supplier sandbox gateway with a sandbox key,
# or the local mock server: http://localhost:4010/esa/api). The catalogue is always read from KINGUIN_API_BASE.
KINGUIN_LIVE_ORDERS="false"
KINGUIN_SANDBOX_API_BASE="http://localhost:4010/esa/api"
KINGUIN_SANDBOX_API_KEY=""
# Secret you enter in the ESA dashboard for webhooks; sent back in the X-Event-Secret header.
# Webhook URL: https://<your-domain>/api/webhooks/esa (events: order.status, product.update)
KINGUIN_WEBHOOK_SECRET=""
# Alert when the supplier balance (EUR) falls below this.
KINGUIN_LOW_BALANCE_THRESHOLD="50"
# Storefront price = max(cost * (1 + CATALOG_MARGIN), cost + CATALOG_MIN_MARGIN_ABS), rounded up to the cent. Defaults live in src/config/catalog.ts.
CATALOG_MARGIN="0.12"
CATALOG_MIN_MARGIN_ABS="0.3"
# Re-price at checkout when the live supplier cost grew by more than this fraction.
CATALOG_PRICE_TOLERANCE="0.05"
# Local development only: read the catalogue from a JSON file instead of the API (npm run catalog:sync).
CATALOG_FIXTURE_FILE=""

# ============================================================
# Key encryption — delivered keys are stored with AES-256-GCM.
# 32+ random characters. Generate: openssl rand -base64 48
# Never change or lose it in production: keys already delivered could no longer be shown to customers.
# ============================================================
KEY_ENCRYPTION_SECRET=""

# ============================================================
# Cron jobs (vercel.json) — Bearer token Vercel sends to /api/cron/*
# Generate: openssl rand -hex 32
# ============================================================
CRON_SECRET=""

# ============================================================
# Operational alerts (optional). Without them, alerts go to the server log.
# ============================================================
ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""
